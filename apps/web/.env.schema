# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# JSON-RPC endpoint for VITE_CHAIN_ID. Optional: unset means http://127.0.0.1:8545 on 31337
# and the public https://ethereum-sepolia-rpc.publicnode.com on 11155111 (src/lib/chain/chains.ts).
# Public: it ships in the browser bundle. Never set a keyed/private RPC URL here.
# @public @optional @type=url
VITE_RPC_URL=

# Chain id: 31337 (local anvil demo) or 11155111 (Sepolia)
# @public @type=number
VITE_CHAIN_ID=31337
