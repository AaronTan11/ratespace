pragma solidity ^0.8.27;

import { Test } from "forge-std/Test.sol";

import { Context } from "@swap-vm/libs/VM.sol";
import { PeggedSwap } from "@swap-vm/instructions/PeggedSwap.sol";

import { MovingPegSwap } from "../src/instructions/MovingPegSwap.sol";
import { MockRateProvider } from "./mocks/MockRateProvider.sol";

/// @notice Direct-VM harness: runs one instruction on an exact Context (no router, no Aqua).
contract ModelParityHarness {
    function mps(bool exactIn, address tokenIn, address tokenOut, uint256 balIn, uint256 balOut, uint256 amount, bytes calldata built)
        external view returns (uint256, uint256)
    {
        Context memory ctx = _ctx(exactIn, tokenIn, tokenOut, balIn, balOut, amount);
        MovingPegSwap.exec(ctx, built[2:]);
        return (ctx.swap.amountIn, ctx.swap.amountOut);
    }

    function ps(bool exactIn, address tokenIn, address tokenOut, uint256 balIn, uint256 balOut, uint256 amount, bytes calldata built)
        external pure returns (uint256, uint256)
    {
        Context memory ctx = _ctx(exactIn, tokenIn, tokenOut, balIn, balOut, amount);
        PeggedSwap.exec(ctx, built[2:]);
        return (ctx.swap.amountIn, ctx.swap.amountOut);
    }

    function _ctx(bool exactIn, address tokenIn, address tokenOut, uint256 balIn, uint256 balOut, uint256 amount)
        private pure returns (Context memory ctx)
    {
        ctx.query.tokenIn = tokenIn;
        ctx.query.tokenOut = tokenOut;
        ctx.query.isExactIn = exactIn;
        ctx.swap.balanceIn = balIn;
        ctx.swap.balanceOut = balOut;
        if (exactIn) ctx.swap.amountIn = amount;
        else ctx.swap.amountOut = amount;
    }
}

/// @notice Model parity: MovingPegSwap.exec (and upstream PeggedSwap.exec) must return, to the wei,
///   the values the exact-integer Python model in analysis/ computed for a fixed table of cases.
///   Tables are generated by `python3 analysis/gen_parity.py` and checked by `--check`.
///   A mismatch means the model or the code is wrong; never loosen to a tolerance.
contract ModelParityTest is Test {
    address internal constant LT = address(0x1000);
    address internal constant GT = address(0x2000);

    ModelParityHarness internal h;
    MockRateProvider internal provider;
    uint256 internal rowMps;
    uint256 internal rowPs;
    uint256 internal rowBand;

    function setUp() public {
        h = new ModelParityHarness();
        provider = new MockRateProvider();
    }

    /// @dev r: see analysis/gen_parity.py (MovingPegSwap row layout)
    function _mps(uint256[16] memory r) internal {
        string memory tag = string.concat("mps row ", vm.toString(rowMps++));
        provider.setRate(r[11]);
        bytes memory built = MovingPegSwap.build(
            r[5], r[6], r[7], r[8], r[9],
            r[10] == 1 ? address(provider) : address(0),
            r[10] == 2 ? address(provider) : address(0),
            uint16(r[12])
        );
        (address tIn, address tOut) = r[0] == 1 ? (LT, GT) : (GT, LT);
        try h.mps(r[1] == 1, tIn, tOut, r[2], r[3], r[4], built) returns (uint256 amountIn, uint256 amountOut) {
            assertEq(r[13], 0, string.concat(tag, ": model expects a revert"));
            assertEq(amountIn, r[14], string.concat(tag, ": amountIn"));
            assertEq(amountOut, r[15], string.concat(tag, ": amountOut"));
        } catch {
            assertEq(r[13], 1, string.concat(tag, ": code reverted, model did not"));
        }
    }

    /// @dev r: see analysis/gen_parity.py (MovingPegSwap hand-encoded band layout). The order bytes
    ///   are build(..., band 1000) with the trailing uint16 band patched to r[12], so they never pass
    ///   build()'s cap check; exec must enforce it (MovingPegSwap.sol:159 ).
    function _mpsBand(uint256[16] memory r) internal {
        string memory tag = string.concat("band row ", vm.toString(rowBand++));
        provider.setRate(r[11]);
        bytes memory built = MovingPegSwap.build(
            r[5], r[6], r[7], r[8], r[9],
            r[10] == 1 ? address(provider) : address(0),
            r[10] == 2 ? address(provider) : address(0),
            1000
        );
        assertEq(uint8(built[built.length - 2]), 0x03, string.concat(tag, ": band 1000 high byte"));
        assertEq(uint8(built[built.length - 1]), 0xE8, string.concat(tag, ": band 1000 low byte"));
        built[built.length - 2] = bytes1(uint8(r[12] >> 8));
        built[built.length - 1] = bytes1(uint8(r[12]));
        if (r[12] > 0 && r[12] <= 1000) {
            // legal band: the patched bytes must equal what build() emits for it
            bytes memory legal = MovingPegSwap.build(
                r[5], r[6], r[7], r[8], r[9],
                r[10] == 1 ? address(provider) : address(0),
                r[10] == 2 ? address(provider) : address(0),
                uint16(r[12])
            );
            assertEq(built, legal, string.concat(tag, ": patched bytes == build()"));
        }
        (address tIn, address tOut) = r[0] == 1 ? (LT, GT) : (GT, LT);
        if (r[13] == 1) {
            vm.expectRevert(abi.encodeWithSelector(MovingPegSwap.MovingPegSwapInvalidMaxDeviation.selector, r[14]));
            h.mps(r[1] == 1, tIn, tOut, r[2], r[3], r[4], built);
        } else {
            (uint256 amountIn, uint256 amountOut) = h.mps(r[1] == 1, tIn, tOut, r[2], r[3], r[4], built);
            assertEq(amountIn, r[14], string.concat(tag, ": amountIn"));
            assertEq(amountOut, r[15], string.concat(tag, ": amountOut"));
        }
    }

    /// @dev r: see analysis/gen_parity.py (PeggedSwap row layout)
    function _ps(uint256[13] memory r) internal {
        string memory tag = string.concat("ps row ", vm.toString(rowPs++));
        bytes memory built = PeggedSwap.build(r[5], r[6], r[7], r[8], r[9]);
        (address tIn, address tOut) = r[0] == 1 ? (LT, GT) : (GT, LT);
        try h.ps(r[1] == 1, tIn, tOut, r[2], r[3], r[4], built) returns (uint256 amountIn, uint256 amountOut) {
            assertEq(r[10], 0, string.concat(tag, ": model expects a revert"));
            assertEq(amountIn, r[11], string.concat(tag, ": amountIn"));
            assertEq(amountOut, r[12], string.concat(tag, ": amountOut"));
        } catch {
            assertEq(r[10], 1, string.concat(tag, ": code reverted, model did not"));
        }
    }

